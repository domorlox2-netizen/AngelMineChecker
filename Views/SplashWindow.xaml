<Window x:Class="AngelMineChecker.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Установка angelmine Checker"
        Icon="/Resources/splash_avatar.png"
        Height="175" Width="410"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F0F0F0"
        FontFamily="Segoe UI, Tahoma, sans-serif">

    <Grid Background="#F0F0F0" Margin="16,16,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="52" Height="52" CornerRadius="8" Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="1" SnapsToDevicePixels="True">
                <Image Source="/Resources/splash_avatar.png" Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <TextBlock Text="Установка, пожалуйста, подождите..."
                       FontSize="12"
                       Foreground="#000000"
                       VerticalAlignment="Center"
                       Margin="14,0,0,0"/>
        </StackPanel>

        <Border Grid.Row="2"
                Height="18"
                Background="#E6E6E6"
                BorderBrush="#BCBCBC"
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <Border x:Name="pbarFill"
                    Background="#06B025"
                    HorizontalAlignment="Left"
                    Width="0"/>
        </Border>
    </Grid>
</Window>
