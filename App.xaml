<Application x:Class="AngelMineChecker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgDark" Color="#0D0E12"/>
        <SolidColorBrush x:Key="BgSidebar" Color="#121319"/>
        <SolidColorBrush x:Key="BgCard" Color="#171922"/>
        <SolidColorBrush x:Key="BgCardHover" Color="#1E202B"/>
        <SolidColorBrush x:Key="BorderDark" Color="#232634"/>
        <SolidColorBrush x:Key="BorderHighlight" Color="#FF6B00"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#FF6B00"/>
        <SolidColorBrush x:Key="AccentOrangeBright" Color="#FF8533"/>
        <SolidColorBrush x:Key="AccentOrangeDim" Color="#331A05"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9B9CA8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#666877"/>
        <SolidColorBrush x:Key="StatusGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="StatusRed" Color="#EF4444"/>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border CornerRadius="3" Background="#2B2D3C"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
