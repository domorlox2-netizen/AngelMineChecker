<Window x:Class="AngelMineChecker.MainWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="AngelMine Checker"

        Height="570" Width="940"

        MinHeight="570" MaxHeight="570"

        MinWidth="940" MaxWidth="940"

        WindowStartupLocation="CenterScreen"

        WindowStyle="None"

        AllowsTransparency="True"

        Background="Transparent"

        FontFamily="Segoe UI Variable Display, Segoe UI, Roboto, Arial, sans-serif"

        TextOptions.TextFormattingMode="Ideal"

        TextOptions.TextRenderingMode="ClearType"

        TextOptions.TextHintingMode="Fixed"

        RenderOptions.ClearTypeHint="Enabled"

        UseLayoutRounding="True"

        SnapsToDevicePixels="True"

        ResizeMode="NoResize">



    <Window.Resources>



        <LinearGradientBrush x:Key="ActivePillGradient" StartPoint="0,0" EndPoint="1,1">

            <GradientStop Color="#FF7A00" Offset="0.0"/>

            <GradientStop Color="#FF5500" Offset="1.0"/>

        </LinearGradientBrush>



        <Style x:Key="WinControlBtn" TargetType="Button">

            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="Foreground" Value="#787C91"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Width" Value="36"/>

            <Setter Property="Height" Value="28"/>

            <Setter Property="FontSize" Value="13"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="border" Property="Background" Value="#1A1D2B"/>

                                <Setter Property="Foreground" Value="#FFFFFF"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <Style x:Key="WinCloseBtn" TargetType="Button" BasedOn="{StaticResource WinControlBtn}">

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="border" Property="Background" Value="#E11D48"/>

                                <Setter Property="Foreground" Value="#FFFFFF"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <Style x:Key="SidebarNavTextBtn" TargetType="RadioButton">

            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="Foreground" Value="#8E95AF"/>

            <Setter Property="Height" Value="40"/>

            <Setter Property="FontSize" Value="13"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Margin" Value="0,4,0,4"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="RadioButton">

                        <Border x:Name="pill" Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True" Padding="14,0">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="pill" Property="Background" Value="#151928"/>

                                <Setter Property="Foreground" Value="#FFFFFF"/>

                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">

                                <Setter TargetName="pill" Property="Background" Value="{StaticResource ActivePillGradient}"/>

                                <Setter Property="Foreground" Value="#FFFFFF"/>

                                <Setter TargetName="pill" Property="Effect">

                                    <Setter.Value>

                                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="1" Opacity="0.45" Color="#FF6B00"/>

                                    </Setter.Value>

                                </Setter>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <Style x:Key="AppCardBtn" TargetType="Button">

            <Setter Property="Background" Value="#10131E"/>

            <Setter Property="Foreground" Value="#D8DCEB"/>

            <Setter Property="BorderBrush" Value="#1B2032"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="FontSize" Value="12.5"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Height" Value="48"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Padding" Value="12,0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="border" Property="Background" Value="#161A2B"/>

                                <Setter TargetName="border" Property="BorderBrush" Value="#FF6B00"/>

                                <Setter Property="Foreground" Value="#FFFFFF"/>

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="border" Property="Background" Value="#241408"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <Style x:Key="FolderBtn" TargetType="Button">

            <Setter Property="Background" Value="#10131E"/>

            <Setter Property="Foreground" Value="#D8DCEB"/>

            <Setter Property="BorderBrush" Value="#1B2032"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="FontSize" Value="14.5"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Height" Value="44"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="border" Property="Background" Value="#161A2B"/>

                                <Setter TargetName="border" Property="BorderBrush" Value="#FF6B00"/>

                                <Setter Property="Foreground" Value="#FFFFFF"/>

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="border" Property="Background" Value="#241408"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <Style x:Key="SocialPillBtn" TargetType="Button">

            <Setter Property="Background" Value="#10131E"/>

            <Setter Property="Foreground" Value="#94A3B8"/>

            <Setter Property="BorderBrush" Value="#1C2132"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Height" Value="30"/>

            <Setter Property="Width" Value="104"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="SnapsToDevicePixels" Value="True"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="border" Property="Background" Value="#181C2C"/>

                                <Setter TargetName="border" Property="BorderBrush" Value="#FF6B00"/>

                                <Setter Property="Foreground" Value="#FFFFFF"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <Style x:Key="ActionCheckBtnPrimary" TargetType="Button">

            <Setter Property="Background" Value="{StaticResource ActivePillGradient}"/>

            <Setter Property="Foreground" Value="#FFFFFF"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="FontSize" Value="13.5"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Height" Value="38"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Padding" Value="18,0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">

                            <Border.Effect>

                                <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="1" Opacity="0.35" Color="#FF6B00"/>

                            </Border.Effect>

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="border" Property="Background">

                                    <Setter.Value>

                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">

                                            <GradientStop Color="#FF8C1A" Offset="0"/>

                                            <GradientStop Color="#FF6600" Offset="1"/>

                                        </LinearGradientBrush>

                                    </Setter.Value>

                                </Setter>

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="border" Property="Background" Value="#E05500"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <Style x:Key="ActionCheckBtnSecondary" TargetType="Button">

            <Setter Property="Background" Value="#10131E"/>

            <Setter Property="Foreground" Value="#D8DCEB"/>

            <Setter Property="BorderBrush" Value="#1B2032"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="FontSize" Value="13.5"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Height" Value="38"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Padding" Value="18,0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="border" Property="Background" Value="#161A2B"/>

                                <Setter TargetName="border" Property="BorderBrush" Value="#FF6B00"/>

                                <Setter Property="Foreground" Value="#FFFFFF"/>

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="border" Property="Background" Value="#241408"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <Style x:Key="ConsoleMiniBtn" TargetType="Button">

            <Setter Property="Background" Value="#0E111E"/>

            <Setter Property="Foreground" Value="#7E87A0"/>

            <Setter Property="BorderBrush" Value="#1A2036"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="FontSize" Value="11.5"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Height" Value="26"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Padding" Value="10,0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="border" Property="Background" Value="#171C30"/>

                                <Setter TargetName="border" Property="BorderBrush" Value="#FF6B00"/>

                                <Setter Property="Foreground" Value="#FFFFFF"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">

            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="26"/>

                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#8B95AC" Data="M 0 0 L 4 4 L 8 0 Z"/>

                </Grid>

            </Border>

            <ControlTemplate.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter TargetName="border" Property="BorderBrush" Value="#FF6B00"/>

                </Trigger>

            </ControlTemplate.Triggers>

        </ControlTemplate>



        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">

            <Setter Property="Foreground" Value="#CBD5E1"/>

            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="Padding" Value="10,7"/>

            <Setter Property="FontSize" Value="12"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBoxItem">

                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="0,1">

                            <ContentPresenter/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="itemBorder" Property="Background" Value="#171C30"/>

                                <Setter Property="Foreground" Value="#FFFFFF"/>

                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">

                                <Setter TargetName="itemBorder" Property="Background" Value="#251608"/>

                                <Setter Property="Foreground" Value="#FF7A00"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <Style x:Key="DarkComboBox" TargetType="ComboBox">

            <Setter Property="Background" Value="#080A12"/>

            <Setter Property="Foreground" Value="#E2E8F0"/>

            <Setter Property="BorderBrush" Value="#1B2032"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Height" Value="34"/>

            <Setter Property="FontSize" Value="12"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <ToggleButton Template="{StaticResource ComboBoxToggleButtonTemplate}"

                                          Background="{TemplateBinding Background}"

                                          BorderBrush="{TemplateBinding BorderBrush}"

                                          BorderThickness="{TemplateBinding BorderThickness}"

                                          Focusable="False"

                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"

                                          ClickMode="Press"/>

                            <ContentPresenter IsHitTestVisible="False"

                                              Content="{TemplateBinding SelectionBoxItem}"

                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"

                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"

                                              Margin="10,0,28,0"

                                              VerticalAlignment="Center"

                                              HorizontalAlignment="Left"/>

                            <Popup x:Name="PART_Popup"

                                   AllowsTransparency="True"

                                   IsOpen="{TemplateBinding IsDropDownOpen}"

                                   Placement="Bottom"

                                   PopupAnimation="Slide"

                                   Focusable="False">

                                <Border x:Name="DropDownBorder"

                                        Background="#0A0D18"

                                        BorderBrush="#1B2032"

                                        BorderThickness="1"

                                        CornerRadius="6"

                                        MinWidth="{TemplateBinding ActualWidth}"

                                        MaxHeight="180"

                                        Padding="4"

                                        Margin="0,4,0,0">

                                    <Border.Effect>

                                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.75" Color="#000000"/>

                                    </Border.Effect>

                                    <ScrollViewer SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">

                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <Style x:Key="DarkInputBox" TargetType="TextBox">

            <Setter Property="Background" Value="#080A12"/>

            <Setter Property="Foreground" Value="#CBD5E1"/>

            <Setter Property="BorderBrush" Value="#1B2032"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="FontSize" Value="12"/>

            <Setter Property="FontFamily" Value="Consolas, Cascadia Code, Courier New"/>

            <Setter Property="Padding" Value="8,0"/>

            <Setter Property="Height" Value="32"/>

            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">

                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="border" Property="BorderBrush" Value="#2A334E"/>

                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">

                                <Setter TargetName="border" Property="BorderBrush" Value="#FF6B00"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>



    <Border CornerRadius="10" Background="#0A0C13" BorderBrush="#181B26" BorderThickness="1">

        <Border.Effect>

            <DropShadowEffect BlurRadius="28" Direction="270" ShadowDepth="4" Opacity="0.80" Color="#000000"/>

        </Border.Effect>



        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="42"/> 

                <RowDefinition Height="*"/>  

                <RowDefinition Height="44"/> 

            </Grid.RowDefinitions>



            <Border Grid.Row="0" Background="#08090F" CornerRadius="10,10,0,0" BorderBrush="#141622" BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseLeftButtonDown">

                <Grid Margin="18,0,12,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>



                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                        <TextBlock Text="ANGELMINE" FontSize="13.5" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,5,0"/>

                        <TextBlock Text="CHECKER" FontSize="13.5" FontWeight="Black" Foreground="#FF6B00" VerticalAlignment="Center"/>

                    </StackPanel>



                    <Grid Grid.Column="1"/>



                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                        <Button Style="{StaticResource WinControlBtn}" Content="—" Click="BtnMinimize_Click" ToolTip="Свернуть"/>

                        <Button Style="{StaticResource WinCloseBtn}" Content="✕" Click="BtnClose_Click" ToolTip="Закрыть"/>

                    </StackPanel>

                </Grid>

            </Border>



            <Grid Grid.Row="1" Background="#0A0C13">



                <Border x:Name="sidebarTrigger"

                        HorizontalAlignment="Left"

                        Width="18"

                        Background="#01000000"

                        Panel.ZIndex="99"

                        Cursor="Hand"

                        MouseEnter="SidebarTrigger_MouseEnter"

                        MouseLeftButtonDown="SidebarTrigger_MouseLeftButtonDown"/>



                <Border x:Name="sidebar"

                        HorizontalAlignment="Left"

                        Width="0"

                        Background="#07080D"

                        BorderBrush="#181B26"

                        BorderThickness="0,0,1,0"

                        Panel.ZIndex="100"

                        ClipToBounds="True"

                        MouseEnter="Sidebar_MouseEnter"

                        MouseLeave="Sidebar_MouseLeave">

                    <Border.Effect>

                        <DropShadowEffect x:Name="sidebarShadow" BlurRadius="24" Direction="0" ShadowDepth="2" Opacity="0" Color="#000000"/>

                    </Border.Effect>



                    <StackPanel Margin="12,18,12,18" Width="136">

                        <RadioButton x:Name="tabBtnCheck" Style="{StaticResource SidebarNavTextBtn}" GroupName="NavTabs" IsChecked="True" Content="Проверка" Checked="NavTab_Checked"/>

                        <RadioButton x:Name="tabBtnTools" Style="{StaticResource SidebarNavTextBtn}" GroupName="NavTabs" Content="Приложения" Checked="NavTab_Checked"/>

                        <RadioButton x:Name="tabBtnOther" Style="{StaticResource SidebarNavTextBtn}" GroupName="NavTabs" Content="Другое" Checked="NavTab_Checked"/>

                        <RadioButton x:Name="tabBtnFaq" Style="{StaticResource SidebarNavTextBtn}" GroupName="NavTabs" Content="FAQ" Checked="NavTab_Checked"/>

                    </StackPanel>

                </Border>



                <Grid Margin="26,14,26,10">



                    <Grid x:Name="viewTools" Visibility="Collapsed">

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                            <StackPanel>



                                <TextBlock Text="Приложения для проверки" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,14"/>



                                <UniformGrid Columns="4" Margin="0,0,0,16">



                                    <Button Style="{StaticResource AppCardBtn}" Margin="0,0,8,8" Click="BtnLaunchEverything_Click">

                                        <Grid Margin="4,0">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="Auto"/>

                                                <ColumnDefinition Width="*"/>

                                            </Grid.ColumnDefinitions>

                                            <Image Source="icons/Everything.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                            <TextBlock Grid.Column="1" Text="Everything" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                        </Grid>

                                    </Button>



                                    <Button Style="{StaticResource AppCardBtn}" Margin="0,0,8,8" Click="BtnLaunchShellBagAnalyzer_Click">

                                        <Grid Margin="4,0">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="Auto"/>

                                                <ColumnDefinition Width="*"/>

                                            </Grid.ColumnDefinitions>

                                            <Image Source="icons/ShellBagAnalyzer.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                            <TextBlock Grid.Column="1" Text="ShellBags" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                        </Grid>

                                    </Button>



                                    <Button Style="{StaticResource AppCardBtn}" Margin="0,0,8,8" Click="BtnLaunchBrowserDownloads_Click">

                                        <Grid Margin="4,0">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="Auto"/>

                                                <ColumnDefinition Width="*"/>

                                            </Grid.ColumnDefinitions>

                                            <Image Source="icons/BrowserDownloadsView.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                            <TextBlock Grid.Column="1" Text="BrowserDownloads" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                        </Grid>

                                    </Button>



                                    <Button Style="{StaticResource AppCardBtn}" Margin="0,0,0,8" Click="BtnLaunchExecutedPrograms_Click">

                                        <Grid Margin="4,0">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="Auto"/>

                                                <ColumnDefinition Width="*"/>

                                            </Grid.ColumnDefinitions>

                                            <Image Source="icons/ExecutedProgramsList.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                            <TextBlock Grid.Column="1" Text="ExecutedProgramms" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                        </Grid>

                                    </Button>



                                    <Button Style="{StaticResource AppCardBtn}" Margin="0,0,8,8" Click="BtnLaunchUSBDeview_Click">

                                        <Grid Margin="4,0">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="Auto"/>

                                                <ColumnDefinition Width="*"/>

                                            </Grid.ColumnDefinitions>

                                            <Image Source="icons/USBDeview.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                            <TextBlock Grid.Column="1" Text="USBDeview" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                        </Grid>

                                    </Button>



                                    <Button Style="{StaticResource AppCardBtn}" Margin="0,0,8,8" Click="BtnLaunchWinPrefetch_Click">

                                        <Grid Margin="4,0">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="Auto"/>

                                                <ColumnDefinition Width="*"/>

                                            </Grid.ColumnDefinitions>

                                            <Image Source="icons/WinPrefetchView.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                            <TextBlock Grid.Column="1" Text="WinPrefetchView" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                        </Grid>

                                    </Button>



                                    <Button Style="{StaticResource AppCardBtn}" Margin="0,0,8,8" Click="BtnLaunchBrowsingHistory_Click">

                                        <Grid Margin="4,0">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="Auto"/>

                                                <ColumnDefinition Width="*"/>

                                            </Grid.ColumnDefinitions>

                                            <Image Source="icons/BrowsingHistoryView.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                            <TextBlock Grid.Column="1" Text="BrowsingHistory" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                        </Grid>

                                    </Button>



                                    <Button Style="{StaticResource AppCardBtn}" Margin="0,0,0,8" Click="BtnLaunchJumpListView_Click">

                                        <Grid Margin="4,0">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="Auto"/>

                                                <ColumnDefinition Width="*"/>

                                            </Grid.ColumnDefinitions>

                                            <Image Source="icons/JumpListsView.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                            <TextBlock Grid.Column="1" Text="JumpListView" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                        </Grid>

                                    </Button>



                                    <Button Style="{StaticResource AppCardBtn}" Margin="0,0,8,8" Click="BtnLaunchUserAssist_Click">

                                        <Grid Margin="4,0">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="Auto"/>

                                                <ColumnDefinition Width="*"/>

                                            </Grid.ColumnDefinitions>

                                            <Image Source="icons/UserAssistView.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                            <TextBlock Grid.Column="1" Text="UserAssistView" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                        </Grid>

                                    </Button>



                                    <Button Style="{StaticResource AppCardBtn}" Margin="0,0,8,8" Click="BtnLaunchProcessHackerFiles_Click">

                                        <Grid Margin="4,0">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="Auto"/>

                                                <ColumnDefinition Width="*"/>

                                            </Grid.ColumnDefinitions>

                                            <Image Source="icons/ProcessHacker.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                            <TextBlock Grid.Column="1" Text="Process Hacker" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                        </Grid>

                                    </Button>



                                    <Button Style="{StaticResource AppCardBtn}" Margin="0,0,8,8" Click="BtnLaunchJournalTrace_Click">

                                        <Grid Margin="4,0">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="Auto"/>

                                                <ColumnDefinition Width="*"/>

                                            </Grid.ColumnDefinitions>

                                            <Image Source="icons/JournalTrace.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                            <TextBlock Grid.Column="1" Text="JournalTrace" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                        </Grid>

                                    </Button>



                                    <Button Style="{StaticResource AppCardBtn}" Margin="0,0,0,8" Click="BtnLaunchSystemInformer_Click">

                                        <Grid Margin="4,0">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="Auto"/>

                                                <ColumnDefinition Width="*"/>

                                            </Grid.ColumnDefinitions>

                                            <Image Source="icons/SystemInformer.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                            <TextBlock Grid.Column="1" Text="System Informer" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                        </Grid>

                                    </Button>

                                </UniformGrid>



                                <TextBlock Text="Папки" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,10,0,14"/>



                                <UniformGrid Columns="4" Margin="0,0,0,8">

                                    <Button Style="{StaticResource FolderBtn}" Margin="0,0,8,0" Click="BtnOpenFolder_Click" Tag="recent" Content="Recent"/>

                                    <Button Style="{StaticResource FolderBtn}" Margin="0,0,8,0" Click="BtnOpenFolder_Click" Tag="prefetch" Content="Prefetch"/>

                                    <Button Style="{StaticResource FolderBtn}" Margin="0,0,8,0" Click="BtnOpenFolder_Click" Tag="appdata" Content="AppData"/>

                                    <Button Style="{StaticResource FolderBtn}" Margin="0,0,0,0" Click="BtnOpenFolder_Click" Tag="temp" Content="Temp"/>

                                </UniformGrid>



                            </StackPanel>

                        </ScrollViewer>

                    </Grid>



                    <Grid x:Name="viewCheck" Visibility="Visible">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="340"/> 

                            <ColumnDefinition Width="16"/>  

                            <ColumnDefinition Width="*"/>   

                        </Grid.ColumnDefinitions>



                        <Grid Grid.Column="0">

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/> 

                                <RowDefinition Height="12"/>   

                                <RowDefinition Height="Auto"/> 

                                <RowDefinition Height="*"/>    

                            </Grid.RowDefinitions>



                            <Border Grid.Row="0" Background="#0E111C" BorderBrush="#1B2134" BorderThickness="1" CornerRadius="8" Padding="14">

                                <Button Style="{StaticResource ActionCheckBtnSecondary}" Content="Быстрая проверка" Height="42" Click="BtnQuickCheck_Click"/>

                            </Border>



                            <Border Grid.Row="2" Background="#0E111C" BorderBrush="#1B2134" BorderThickness="1" CornerRadius="8" Padding="14">

                                <StackPanel>

                                    <Button Style="{StaticResource ActionCheckBtnSecondary}" Content="Тонкая проверка" Height="42" Click="BtnDeepCheck_Click"/>



                                    <Border Height="1" Background="#161B2B" Margin="0,14,0,12"/>



                                    <TextBlock Text="ID ПРОЦЕССА (PID)" FontSize="11" FontWeight="Bold" Foreground="#8B95AC" Margin="0,0,0,8"/>



                                    <ComboBox x:Name="comboProcesses" Style="{StaticResource DarkComboBox}" ItemContainerStyle="{StaticResource DarkComboBoxItem}" DropDownOpened="ComboProcesses_DropDownOpened" SelectionChanged="ComboProcesses_SelectionChanged" Margin="0,0,0,8"/>



                                    <Grid Height="32" VerticalAlignment="Center">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto"/>

                                            <ColumnDefinition Width="*"/>

                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="PID вручную:" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                        <TextBox x:Name="txtProcessId" Grid.Column="1" Style="{StaticResource DarkInputBox}" VerticalAlignment="Center" TextChanged="TxtProcessId_TextChanged"/>

                                    </Grid>

                                </StackPanel>

                            </Border>

                        </Grid>



                        <Border Grid.Column="2" Background="#06080E" BorderBrush="#161928" BorderThickness="1" CornerRadius="8">

                            <Grid>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="*"/>  

                                    <RowDefinition Height="38"/> 

                                </Grid.RowDefinitions>



                                <ScrollViewer x:Name="scrollCheckLogs" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,12">

                                    <TextBox x:Name="txtCheckLogs"

                                             Background="Transparent"

                                             Foreground="#94A3B8"

                                             BorderThickness="0"

                                             FontFamily="Consolas, Cascadia Code, Courier New"

                                             FontSize="12"

                                             IsReadOnly="True"

                                             TextWrapping="Wrap"

                                             Text=""/>

                                </ScrollViewer>



                                <Border Grid.Row="1" Background="#080A12" BorderBrush="#131624" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" Padding="10,0">

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                                        <Button Style="{StaticResource ConsoleMiniBtn}" Content="Очистить" Margin="0,0,6,0" Click="BtnClearLogs_Click"/>

                                        <Button Style="{StaticResource ConsoleMiniBtn}" Content="Копировать" Margin="0,0,6,0" Click="BtnCopyLogs_Click"/>

                                        <Button Style="{StaticResource ConsoleMiniBtn}" Content="Сохранить лог" Click="BtnSaveLogs_Click"/>

                                    </StackPanel>

                                </Border>

                            </Grid>

                        </Border>

                    </Grid>



                    <Grid x:Name="viewOther" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="280"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1.2*" MinWidth="320"/>
                            </Grid.ColumnDefinitions>

                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,0,16">
                                    <Border Background="#0E111C" BorderBrush="#1B2134" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="ДАТА УСТАНОВКИ WINDOWS" FontSize="11" FontWeight="Bold" Foreground="#8B95AC"/>
                                            <TextBlock x:Name="txtWindowsInstallDate" Text="Загрузка..." FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#0E111C" BorderBrush="#1B2134" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="OBS" FontSize="11" FontWeight="Bold" Foreground="#8B95AC"/>
                                            <TextBlock x:Name="txtObsStatus" Text="Проверка..." FontSize="13" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#0E111C" BorderBrush="#1B2134" BorderThickness="1" CornerRadius="8" Padding="16,14">
                                        <StackPanel>
                                            <TextBlock Text="Демка" FontSize="11" FontWeight="Bold" Foreground="#8B95AC"/>
                                            <TextBlock x:Name="txtDiscordStatus" Text="Проверка..." FontSize="13" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Column="2" Background="#0E111C" BorderBrush="#1B2134" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="txtNicksTitle" Text="Ники игрока" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="btnCopyNicks" Style="{StaticResource ConsoleMiniBtn}" Content="Скопировать" Margin="0,0,6,0" Click="BtnCopyNicks_Click"/>
                                            <Button x:Name="btnDownloadNicks" Style="{StaticResource ConsoleMiniBtn}" Content="Скачать" Click="BtnDownloadNicks_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <ItemsControl x:Name="itemsNicksList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#080A12" BorderBrush="#161B2B" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,6">
                                                           <Grid>
                                                               <Grid.ColumnDefinitions>
                                                                   <ColumnDefinition Width="*"/>
                                                                   <ColumnDefinition Width="Auto"/>
                                                                   <ColumnDefinition Width="Auto"/>
                                                               </Grid.ColumnDefinitions>
                                                               <TextBlock Text="{Binding Nickname}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                               <TextBlock Grid.Column="1" Text="{Binding SourceDisplay}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="12,0,12,0"/>
                                                               <Button Grid.Column="2" Style="{StaticResource ConsoleMiniBtn}" Content="Копировать" Height="22" Padding="8,0" Click="BtnCopySingleNick_Click" Tag="{Binding Nickname}"/>
                                                           </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock x:Name="txtNoNicks" Text="Ники не обнаружены на этом ПК." FontSize="12" Foreground="#64748B" Visibility="Collapsed" Margin="4,8,0,0"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="viewFaq" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,0,20">
                                <Border Background="#0E111C" BorderBrush="#1B2134" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="5.1 Вы обязаны выполнять требования Проверяющего." FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                                        <Border Background="#0E111C" BorderBrush="#1B2134" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,6,0,0">
                                            <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="#94A3B8">
                                                <Run FontWeight="Bold" Foreground="#FFFFFF" Text="Важно! "/>
                                                <Run Text="Проверка проводится исключительно в целях поиска читов, запрещённых модификаций, программ и другого запрещённого ПО. Поэтому если Проверяющий просит Вас выполнить нелогичные для проверки действия (включить веб-камеру, &quot;похрюкать&quot;, дать ему ресурсы) — отключайтесь от проверки и срочно сообщите об этом Администрации."/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Background="#0E111C" BorderBrush="#1B2134" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="5.5 Запрещается препятствовать проведению проверки:" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                        <TextBlock Text="долго открывать папки, задавать неуместные вопросы, оскорблять/унижать Проверяющего, игнорировать его требования и так далее."
                                                   TextWrapping="Wrap" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#0E111C" BorderBrush="#1B2134" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
                                    <TextBlock Text="5.6 Во время проверки запрещается удалять какие-либо файлы с Вашего ПК, в том числе очищать корзину."
                                               TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                </Border>

                                <Border Background="#0E111C" BorderBrush="#1B2134" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="5.8 Запрещается снимать ход проверки." FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Исключение: личное разрешение Проверяющего." FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#0E111C" BorderBrush="#1B2134" BorderThickness="1" CornerRadius="8" Padding="16,14">
                                    <StackPanel>
                                        <TextBlock Text="За любые эти действия и за наход читов = бану" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Исключения 5.8, 5.1" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

